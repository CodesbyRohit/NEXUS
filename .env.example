# ---------------------------------------------------------------------------
# NEXUS environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- FalkorDB (graph database) ---------------------------------------------
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=nexus

# --- LLM (optional) --------------------------------------------------------
# NEXUS runs fully without an LLM using its deterministic, graph-grounded
# reasoning engine. If a key is present the LLM is used ONLY to narrate facts
# that were already retrieved from the graph. It never invents facts.
#
# Supported providers (auto-detected from whichever key is set):
#   LLM_PROVIDER=openai|anthropic|gemini|openai_compatible
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# For openai_compatible providers (e.g. Groq, Together, local Ollama):
LLM_BASE_URL=

# --- Backend ---------------------------------------------------------------
BACKEND_PORT=8000
# Comma separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (Vite) -------------------------------------------------------
# Base URL the frontend uses to reach the API. Leave EMPTY when the backend
# serves the built frontend from the same origin (the default for `npm run
# build` + uvicorn). Set it to http://localhost:8000 only if you serve the UI
# from a different origin and are not using the Vite dev proxy.
VITE_API_BASE=
